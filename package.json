{
  "name": "webvisor",
  "version": "0.1.0",
  "description": "A systems programming architecture for virtualizing the web platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "benchmark": "node --experimental-specifier-resolution=node benchmarks/run.js"
  },
  "keywords": [
    "hypervisor",
    "virtualization",
    "web-platform",
    "debugging",
    "time-travel",
    "deterministic",
    "testing",
    "profiling"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.54.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2",
    "vite": "^5.0.5",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^1.0.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
